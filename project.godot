; Engine configuration file.
; Godot 4.x project initialized from the Notion source of truth.
config_version=5

[application]

config/name="무차우: 한 잔의 도"
config/description="Top-down 32x32 pixel-art roguelike RPG. Notion is the planning source of truth; runtime uses exported static data."
run/main_scene="res://src/main/main.tscn"
config/features=PackedStringArray("4.x")

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

textures/canvas_textures/default_texture_filter=0
2d/snapping/use_gpu_pixel_snap=true

