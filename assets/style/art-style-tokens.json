{
  "schema_version": 1,
  "id": "samurai-tea-fox-art-style-tokens",
  "title": "무사여우: 한 잔의 도 아트 스타일 토큰",
  "management_rule": {
    "priority": "이미지 생성, PixelLab, 스프라이트 제작 프롬프트는 이 파일을 최우선으로 읽는다.",
    "single_source": "색상 팔레트, 공통 시각 컨셉, 이미지 생성용 positive/negative 토큰은 다른 문서에 복제하지 않는다.",
    "notion_alignment": "상위 기획 정본은 Notion 09. 아트디렉션·맵·UI와 🎨 아트 에셋 DB다.",
    "runtime_boundary": "이 파일은 제작용 스타일 토큰이며 게임 런타임이 Notion API를 호출한다는 뜻이 아니다."
  },
  "source_context": {
    "notion_art_direction": {
      "title": "09. 아트디렉션·맵·UI",
      "url": "https://app.notion.com/p/3c9373699e6681eab381e085f0ac1b89?pvs=204",
      "last_checked": "2026-09-01"
    },
    "notion_asset_database": {
      "title": "🎨 아트 에셋",
      "role": "실제 제작 에셋 목록, 규격, 방향 수, 프레임 수, 제작 상태, 파일의 정본"
    }
  },
  "project_concept": {
    "short": "귀여운 여우 사무라이와 다도 미학을 결합한 32x32 저해상도 픽셀아트 로그라이크",
    "mood": [
      "조용함",
      "절제",
      "낡은 물건의 온기",
      "다도적 여백",
      "읽기 쉬운 모험감"
    ],
    "motifs": [
      "붉은여우 귀와 꼬리",
      "작은 검 또는 단도",
      "찻잎",
      "차통",
      "다구",
      "수선 흔적",
      "산길",
      "숲",
      "강",
      "사찰과 다실"
    ],
    "avoid_mood": [
      "과한 영웅 판타지",
      "어두운 고어",
      "현대 SF",
      "네온 사이버펑크",
      "고광택 모바일 RPG"
    ]
  },
  "pixel_rules": {
    "base_tile_size_px": 32,
    "sprite_base_size_px": 32,
    "view_model": "square_tile_top_view",
    "orientation": "front_facing_only",
    "orientation_rule": "모든 캐릭터, 맵, 맵 내 사물은 정사각형 타일 기반 탑뷰 로그라이크 가독성을 위해 정면을 보게 제작한다.",
    "texture_filter": "nearest",
    "scale": "integer_preferred",
    "anti_aliasing": "avoid",
    "lighting": "minimal",
    "shading": "minimal_two_or_three_steps",
    "linework": "clear_outline_first",
    "detail_density": "low",
    "readability": "silhouette_first",
    "max_colors_per_32px_sprite": 12,
    "max_colors_per_32px_tile": 10
  },
  "style_pillars": [
    {
      "id": "cute_fox_silhouette",
      "name": "귀여운 여우 실루엣",
      "rule": "큰 귀와 꼬리가 먼저 읽혀야 한다."
    },
    {
      "id": "samurai_restraint",
      "name": "사무라이적 절제",
      "rule": "장비와 포즈는 과장보다 단순한 방향성과 균형을 우선한다."
    },
    {
      "id": "tea_ceremony_calm",
      "name": "다도적 고요",
      "rule": "차, 다구, 다실 요소는 회복과 여백의 인상을 준다."
    },
    {
      "id": "wabi_sabi_wear",
      "name": "와비사비 사용감",
      "rule": "흠집, 마모, 수선, 비대칭은 실패가 아니라 시간과 관계의 흔적으로 표현한다."
    },
    {
      "id": "minimal_readability",
      "name": "미니멀 가독성",
      "rule": "언더테일처럼 단순하고 읽기 쉬운 화면 구성을 우선한다."
    },
    {
      "id": "front_facing_top_view",
      "name": "정면 고정 탑뷰",
      "rule": "정사각형 타일 기반 탑뷰 로그라이크이므로 캐릭터, 맵, 맵 내 사물은 모두 정면을 보며, 측면·후면·3/4·아이소메트릭 시점으로 제작하지 않는다."
    }
  ],
